POSTGRES_DB=radar_odio
POSTGRES_USER=radar_odio
# Use letras, números e hífens; caracteres reservados exigem codificação na URI.
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-unica

GEMMA_MODEL=gemma3:4b
GEMMA_PROMPT_VERSION=gemma3_4b_structured_v2
REVIEW_SESSION_DAYS=7
RUN_DB_MIGRATIONS=true
DB_WAIT_SECONDS=300

# Porta local de diagnóstico. O acesso dos avaliadores deve usar HTTPS.
APP_PORT=3000

# Opção 1: domínio apontado para o IP da VM, usando o perfil "https".
SITE_DOMAIN=avaliacao.seudominio.com.br

# Opção 2: túnel nomeado do Cloudflare, usando o perfil "cloudflare".
CLOUDFLARE_TUNNEL_TOKEN=
